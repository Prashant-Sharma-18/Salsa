# Copy to .env for local development. Placeholders only — never commit real secrets.

APP_NAME=LoyalLoop
# development | test | production
APP_ENV=development
# Required outside development. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# SQLite for local development; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg2://loyalloop:password@localhost:5432/loyalloop
DATABASE_URL=sqlite:///loyalloop.db

# Public URL of the web app, used to build links in emails
PUBLIC_BASE_URL=http://localhost:5173
# Comma-separated origins allowed to call the API cross-origin. Leave empty for same-origin deployments.
CORS_ORIGINS=

# Must be true in production (HTTPS)
COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=7

# Local demo data and the dev mailbox. Refused when APP_ENV=production.
DEMO_MODE=true

# Email: "console" (logs a redacted summary; use the dev mailbox locally) or "smtp".
# Emails are queued and sent by the worker: `flask email-worker` (or `flask deliver-emails` for one batch).
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_REPLY_TO=
# SMTP relay examples:
#   SendGrid  SMTP_HOST=smtp.sendgrid.net        SMTP_USERNAME=apikey          SMTP_PASSWORD=<api key>
#   Postmark  SMTP_HOST=smtp.postmarkapp.com     SMTP_USERNAME=<server token>  SMTP_PASSWORD=<server token>
#   SES       SMTP_HOST=email-smtp.us-east-1.amazonaws.com  SMTP_USERNAME/SMTP_PASSWORD=<SMTP credentials>
#   Mailgun   SMTP_HOST=smtp.mailgun.org         SMTP_USERNAME=postmaster@<domain>  SMTP_PASSWORD=<password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587) | ssl (port 465) | none (local testing only; refused in production)
SMTP_SECURITY=starttls
SMTP_TIMEOUT=15

# Account lockout after this many failed sign-in attempts (password or two-factor code)
LOCKOUT_THRESHOLD=10
LOCKOUT_MINUTES=15

# Two-factor secrets are encrypted with this Fernet key. If empty it is derived from SECRET_KEY
# (then rotating SECRET_KEY forces users to re-enrol). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Number of reverse proxies in front of the app (e.g. 1 behind a load balancer). Leave 0 if none:
# a wrong value lets clients spoof their IP and dodge rate limits.
TRUSTED_PROXY_COUNT=0

# Billing: dev (simulated plan switching, non-production only) | stripe | none (default in production)
BILLING_PROVIDER=dev
# Stripe (BILLING_PROVIDER=stripe). Create one recurring monthly price per plan in the Stripe dashboard.
# Webhook endpoint: https://<your-domain>/api/v1/billing/stripe/webhook with events:
#   checkout.session.completed, customer.subscription.created/updated/deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

RATELIMIT_ENABLED=true
# Use Redis in production so limits are shared across workers, e.g. redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
REFERRAL_DAILY_SIGNUP_LIMIT=20
